# Optional AI providers. Leave unused keys empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Browser speech is the default; OpenAI speech requires an API key.
USE_OPENAI_TTS=false

# Optional local enrichment of retrieved fashion trends.
TREND_USE_OLLAMA=false
# TREND_SEASON=autumn
# TREND_SOURCES_FILE=path/to/trend_sources.json
